# Secretos
.env

# Python
__pycache__/
.venv/

# Sistema
.DS_Store

# Audio de pruebas y bloques intermedios
pruebas/salida/
episodes/*/bloques/

# Material de trabajo con titulares y extractos de los medios: nunca al repositorio
# público (ver investigacion/analisis-legal.md). Solo se publican guion, notas y memoria.
episodes/*/articulos.json
episodes/*/news.json
episodes/*/pasadas/
episodes/*/escaleta.json
episodes/*/revision.md
episodes/*/revision-detalle.md
# Dónde dejó ops el audio de revisión en R2 (ruta no enlazada)
episodes/*/revision-ops.json
# Comentarios ya aplicados desde ops (para no aplicarlos dos veces)
episodes/*/comentarios-ops/

# Investigación interna
investigacion/

# Cachés locales
cache/

# Audio de episodios (va a R2, no al repositorio)
episodes/*/*.wav
episodes/*/*.m4a
episodes/*/*.mp3

# Material de diseño descartado o pesado (se queda en local)
assets/portada/variante-*.jpg
assets/portada/comparativa.png
assets/separador/separador-*.wav
assets/sintonia/original-*.wav

# Registros de la preparación nocturna
logs/
assets/favicon/variante-*
assets/favicon/comparativa.png
episodes/*/portada.jpg
episodes/*/portada-web.jpg
