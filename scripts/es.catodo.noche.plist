<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tarea de launchd: prepara el episodio de Cátodo a las 23:00 de domingo a jueves.
     Si el Mac está dormido a esa hora, se ejecuta al despertar. Se instala con make instalar-noche. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>es.catodo.noche</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>RUTA_CATODO/scripts/noche.sh</string></array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>RUTA_CATODO/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>RUTA_CATODO/logs/launchd.log</string>
</dict>
</plist>
